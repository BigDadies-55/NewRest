<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>ניהול תפריט - כולל הסבר מנה</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f0f2f5; padding: 20px; direction: rtl; color: #333; }
        .admin-card { max-width: 850px; margin: auto; background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .form-and-preview { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 25px; background: #fafafa; padding: 20px; border-radius: 15px; border: 1px solid #eaeaea; }
        .form-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
        label { display: block; margin-bottom: 4px; font-weight: bold; font-size: 0.9em; }
        input, select, textarea, button { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; box-sizing: border-box; font-family: inherit; }
        textarea { resize: vertical; min-height: 80px; }
        .preview-area { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2px dashed #ddd; border-radius: 10px; background: #fff; cursor: pointer; position: relative; overflow: hidden; height: 100%; }
        .preview-img-big { max-width: 100%; max-height: 250px; border-radius: 8px; display: none; }
        .btn-add { background: #27ae60; color: white; border: none; cursor: pointer; font-weight: bold; font-size: 1.1em; padding: 15px; }
        .btn-update { background: #2980b9; color: white; display: none; padding: 15px; }
        .category-group { margin-top: 10px; border: 1px solid #eee; border-radius: 10px; overflow: hidden; }
        .category-header { background: #34495e; color: white; padding: 15px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: bold; }
        .category-content { display: none; background: white; padding: 10px; }
        .category-group.active .category-content { display: block; }
        .item-row { display: flex; align-items: center; padding: 12px; border-bottom: 1px solid #f1f1f1; }
        .item-img { width: 50px; height: 50px; object-fit: cover; border-radius: 8px; margin-left: 15px; }
        .item-info { flex-grow: 1; }
        .item-desc-preview { font-size: 0.85em; color: #666; display: block; max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .btn-sm { width: auto; padding: 6px 12px; margin-right: 5px; cursor: pointer; border: none; border-radius: 5px; color: white; font-size: 0.85em; }
    </style>
</head>
<body>

<div class="admin-card">
    <h2>🛠️ ניהול תפריט - הוספת הסברים</h2>

    <div id="editor-form">
        <input type="hidden" id="editId">
        <div class="form-and-preview">
            <div class="form-grid">
                <div>
                    <label>שם המנה:</label>
                    <input type="text" id="itemName" placeholder="למשל: המבורגר אנגוס">
                </div>
                <div>
                    <label>מחיר (₪):</label>
                    <input type="number" id="itemPrice" placeholder="0.00">
                </div>
                <div>
                    <label>קטגוריה:</label>
                    <select id="itemCategory">
                        <option value="ראשונות">ראשונות</option>
                        <option value="עיקריות">עיקריות</option>
                        <option value="קינוחים">קינוחים</option>
                        <option value="שתייה">שתייה</option>
                    </select>
                </div>
                <div>
                    <label>הסבר על המנה (תיאור):</label>
                    <textarea id="itemDesc" placeholder="מה המנה מכילה? (למשל: בקר מיושן, איולי כמהין, חסה ועגבניה...)"></textarea>
                </div>
            </div>

            <div class="preview-area" onclick="document.getElementById('imageFile').click()">
                <div id="previewPlaceholder" style="text-align:center; color:#888;">
                    <span style="font-size:2em">📷</span><br>לחץ לתמונה
                </div>
                <img src="" class="preview-img-big" id="previewImgBig">
                <input type="file" id="imageFile" accept="image/*" style="display:none" onchange="handleFileSelect(this)">
                <input type="hidden" id="itemBase64">
            </div>
        </div>

        <button id="addBtn" onclick="addItem()" class="btn-add">➕ הוסף מנה לתפריט</button>
        <button id="updateBtn" onclick="updateItem()" class="btn-update">💾 שמור שינויים</button>
        <button id="cancelBtn" onclick="resetForm()" style="display:none; background:#95a5a6; color:white; margin-top:8px; cursor:pointer;">ביטול עריכה</button>
    </div>

    <hr style="margin: 30px 0; border: 0; border-top: 1px solid #eaeaea;">
    <div id="accordion-container"></div>
    
    <div style="margin-top: 25px; display: flex; gap: 10px; background: #eee; padding: 15px; border-radius: 10px;">
        <button onclick="saveToFile()" style="background:#34495e; color:white; width:auto; cursor:pointer;">💾 הורד קובץ JSON</button>
    </div>
</div>

<script>
    let menuItems = JSON.parse(localStorage.getItem('restaurantMenu')) || [];

    function handleFileSelect(input) {
        const file = input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.src = e.target.result;
            img.onload = function() {
                const canvas = document.createElement('canvas');
                const MAX_WIDTH = 800;
                let width = img.width, height = img.height;
                if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                canvas.width = width; canvas.height = height;
                canvas.getContext('2d').drawImage(img, 0, 0, width, height);
                const compressed = canvas.toDataURL('image/jpeg', 0.6);
                document.getElementById('itemBase64').value = compressed;
                showBigPreview(compressed);
            };
        };
        reader.readAsDataURL(file);
    }

    function showBigPreview(src) {
        const img = document.getElementById('previewImgBig');
        const ph = document.getElementById('previewPlaceholder');
        if(src) { img.src = src; img.style.display = 'block'; ph.style.display = 'none'; }
        else { img.style.display = 'none'; ph.style.display = 'block'; }
    }

    function render() {
        const container = document.getElementById('accordion-container');
        container.innerHTML = "";
        const grouped = menuItems.reduce((acc, i) => { acc[i.category] = acc[i.category] || []; acc[i.category].push(i); return acc; }, {});
        ["ראשונות", "עיקריות", "קינוחים", "שתייה"].forEach(cat => {
            const items = grouped[cat] || [];
            const groupDiv = document.createElement('div');
            groupDiv.className = "category-group";
            groupDiv.innerHTML = `
                <div class="category-header" onclick="this.parentElement.classList.toggle('active')">
                    <span>${cat} (${items.length})</span><span>▼</span>
                </div>
                <div class="category-content">
                    ${items.map(item => `
                        <div class="item-row">
                            <img src="${item.image || ''}" class="item-img" onerror="this.src='https://via.placeholder.com/50'">
                            <div class="item-info">
                                <strong>${item.name}</strong> - ₪${item.price}
                                <span class="item-desc-preview">${item.desc || 'אין הסבר'}</span>
                            </div>
                            <button class="btn-sm" style="background:#f39c12" onclick="startEdit(${item.id})">ערוך</button>
                            <button class="btn-sm" style="background:#e74c3c" onclick="deleteItem(${item.id})">מחק</button>
                        </div>
                    `).join('')}
                </div>`;
            container.appendChild(groupDiv);
        });
        localStorage.setItem('restaurantMenu', JSON.stringify(menuItems));
    }

    function addItem() {
        const name = document.getElementById('itemName').value;
        const price = document.getElementById('itemPrice').value;
        const category = document.getElementById('itemCategory').value;
        const desc = document.getElementById('itemDesc').value;
        const image = document.getElementById('itemBase64').value;
        if(!name || !price) return alert("מלא פרטים");
        menuItems.push({ id: Date.now(), name, price, category, desc, image });
        resetForm(); render();
    }

    function startEdit(id) {
        const item = menuItems.find(i => i.id === id);
        document.getElementById('editId').value = item.id;
        document.getElementById('itemName').value = item.name;
        document.getElementById('itemPrice').value = item.price;
        document.getElementById('itemCategory').value = item.category;
        document.getElementById('itemDesc').value = item.desc || '';
        document.getElementById('itemBase64').value = item.image || '';
        showBigPreview(item.image);
        document.getElementById('addBtn').style.display = 'none';
        document.getElementById('updateBtn').style.display = 'block';
        document.getElementById('cancelBtn').style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateItem() {
        const id = parseInt(document.getElementById('editId').value);
        const idx = menuItems.findIndex(i => i.id === id);
        if(idx !== -1) {
            menuItems[idx].name = document.getElementById('itemName').value;
            menuItems[idx].price = document.getElementById('itemPrice').value;
            menuItems[idx].category = document.getElementById('itemCategory').value;
            menuItems[idx].desc = document.getElementById('itemDesc').value;
            menuItems[idx].image = document.getElementById('itemBase64').value;
            resetForm(); render();
        }
    }

    function deleteItem(id) { if(confirm("למחוק?")) { menuItems = menuItems.filter(i => i.id !== id); render(); } }
    function resetForm() {
        document.getElementById('editId').value = ''; document.getElementById('itemName').value = '';
        document.getElementById('itemPrice').value = ''; document.getElementById('itemDesc').value = '';
        document.getElementById('itemBase64').value = ''; showBigPreview('');
        document.getElementById('addBtn').style.display = 'block';
        document.getElementById('updateBtn').style.display = 'none';
        document.getElementById('cancelBtn').style.display = 'none';
    }
    function saveToFile() { 
        const blob = new Blob([JSON.stringify(menuItems)], {type: 'application/json'});
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
        a.download = 'menu_db.json'; a.click();
    }
    render();
</script>
</body>
</html>
